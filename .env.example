# ============================================================
# FeedbackKit — Environment Variables
# ============================================================
# Copy this to .env.local and fill in your values

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/feedbackkit"

# --- Auth (NextAuth.js) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@feedbackkit.threestack.io"

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs
STRIPE_PRICE_INDIE=""   # $9/mo
STRIPE_PRICE_PRO=""     # $19/mo
STRIPE_PRICE_TEAM=""    # $49/mo
